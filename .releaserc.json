{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "generateNotesCmd": "cat RELEASE_NOTES.md",
        "prepareCmd": "npm run build && npm run test:build && test -s dist/release/sbg-vanilla-plus.user.js && test -s dist/release/sbg-vanilla-plus.meta.js"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "dist/release/sbg-vanilla-plus.user.js",
          "dist/release/sbg-vanilla-plus.meta.js"
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
