{
  "name": "sbg-vanilla-plus",
  "version": "0.15.1",
  "type": "module",
  "private": true,
  "description": "UI/UX enhancements for SBG",
  "author": "wrager <https://github.com/wrager>",
  "homepage": "https://github.com/wrager/sbg-vanilla-plus",
  "repository": {
    "type": "git",
    "url": "https://github.com/wrager/sbg-vanilla-plus.git"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --mode debug --watch",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "test:build": "node --test scripts/buildWorkflow.test.mjs scripts/checkRelease.test.mjs scripts/toolchain.test.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "skills:sync": "node scripts/syncSkills.mjs --write",
    "skills:check": "node scripts/syncSkills.mjs --check && node --test scripts/syncSkills.test.mjs",
    "refs:fetch": "node scripts/fetchRefs.mjs",
    "release:check": "node scripts/checkRelease.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/environment-jsdom-abstract": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "jest": "^30.5.2",
    "jsdom": "^30.1.3",
    "magic-string": "^1.4.3",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-monkey": "^8.1.1"
  }
}
