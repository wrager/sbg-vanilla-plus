{
  "name": "sbg-vanilla-plus",
  "version": "0.15.1",
  "type": "module",
  "private": true,
  "description": "UI/UX enhancements for SBG",
  "author": "wrager <https://github.com/wrager>",
  "homepage": "https://github.com/wrager/sbg-vanilla-plus",
  "repository": {
    "type": "git",
    "url": "https://github.com/wrager/sbg-vanilla-plus.git"
  },
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --mode debug --watch",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "test:build": "node --test scripts/buildWorkflow.test.mjs scripts/checkRelease.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "skills:sync": "node scripts/syncSkills.mjs --write",
    "skills:check": "node scripts/syncSkills.mjs --check && node --test scripts/syncSkills.test.mjs",
    "refs:fetch": "node scripts/fetchRefs.mjs",
    "release:check": "node scripts/checkRelease.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "magic-string": "^0.30.21",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vite-plugin-monkey": "^5.0.0"
  }
}
